process exabgp_json_sink {
  run /usr/bin/env python3 /opt/exabgp/event_sink.py;
  encoder json;
}

neighbor 10.220.0.254 {
  router-id 10.220.0.71;
  local-address 10.220.0.71;
  local-as 65199;
  peer-as 220;
  family {
    ipv4 unicast;
  }
  api {
    processes [ exabgp_json_sink ];
  }
  static {
    route 203.0.113.0/24 next-hop self;
  }

}

